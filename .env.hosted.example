# Copy to .env.hosted.local and fill in. That filename is gitignored (.env*.local).
#
# These are HOSTED-PROJECT OPERATOR credentials. They are used only by the
# Supabase CLI and by the node scripts in scripts/ — never by the app, and never
# with an EXPO_PUBLIC_ prefix. Anything EXPO_PUBLIC_ is embedded in the APK.
#
# Load them into the current PowerShell session with:
#   . .\scripts\load-hosted-env.ps1
#
# Or pass the file straight to a node script (Node >= 20.6):
#   node --env-file=.env.hosted.local .\scripts\seed-test-users.mjs

# --- Postgres wire-protocol credential -----------------------------------
# Dashboard -> Project Settings -> Database -> Database password.
# Required by `supabase db reset --linked` and `supabase db push`.
# This is NOT the service-role key; a JWT cannot authenticate a libpq connection.
SUPABASE_DB_PASSWORD=

# --- HTTP API credentials -------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://hmbraapdnkoxpepdqgaa.supabase.co

# Bypasses ALL row-level security. Needed by the seed/verify scripts only.
# Never commit, never log, never place in .env or any EXPO_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Same value as EXPO_PUBLIC_SUPABASE_ANON_KEY in .env, under the non-prefixed
# name. invoke-payment.mjs, invoke-disbursement.mjs, invoke-provision.mjs and
# invoke-reconcile.mjs sign in as a real user with this. Without it they fall
# back to the local demo anon key and fail against a hosted project.
SUPABASE_ANON_KEY=

# --- Direct database connection ------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Used by scripts/verify-db-state.mjs and the *.sql helpers.
# Percent-encode any special characters in the password.
SUPABASE_DB_URL=
